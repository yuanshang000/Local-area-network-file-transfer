<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".SenderActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 步骤1: 选择文件 -->
        <LinearLayout
            android:id="@+id/selectFileLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="步骤 1/2: 选择文件"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/selectFileButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="选择要发送的文件"
                android:textSize="16sp"
                android:padding="16dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/selectedFileText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="未选择文件"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/nextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="下一步"
                android:textSize="16sp"
                android:padding="16dp"
                android:enabled="false"/>

        </LinearLayout>

        <!-- 步骤2: 连接设备 -->
        <LinearLayout
            android:id="@+id/connectLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="步骤 2/2: 连接接收方"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/hintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="请先连接到接收方的虚拟WiFi热点:\n名称: LAN-Transfer\n密码: 12345678\n(无需网络，仅需局域网连接)"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/scanQRButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="扫描二维码连接"
                android:textSize="16sp"
                android:padding="16dp"
                android:drawableStart="@android:drawable/ic_menu_camera"
                android:drawablePadding="8dp"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/inputCodeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="输入匹配码连接"
                android:textSize="16sp"
                android:padding="16dp"
                android:drawableStart="@android:drawable/ic_menu_edit"
                android:drawablePadding="8dp"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/bluetoothButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="蓝牙寻找连接"
                android:textSize="16sp"
                android:padding="16dp"
                android:drawableStart="@android:drawable/stat_sys_data_bluetooth"
                android:drawablePadding="8dp"/>

        </LinearLayout>

        <!-- 传输进度 -->
        <LinearLayout
            android:id="@+id/transferLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="正在传输..."
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/fileNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="文件名"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/progressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textSize="14sp"
                android:gravity="center"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>